@page "/myloans"
@using LibraryBlazor.Features.MyLoans.Models
@using LibraryBlazor.Features.MyLoans.Components
@using LibraryBlazor.Shared.Models
@using LibraryBlazor.Http

<PageTitle>@(_activeTab == "loans" ? "My Loans" : "My Fines")</PageTitle>

<div class="page-header mb-3">
    <h3 class="page-title">@(_activeTab == "loans" ? "My Loans" : "My Fines")</h3>
</div>

<ul class="nav myloans-tabs">
    <li class="nav-item">
        <button class="myloans-tab-btn @(_activeTab == "loans" ? "active" : "")" @onclick='() => _activeTab = "loans"'>
            My Loans
        </button>
    </li>
    <li class="nav-item">
        <button class="myloans-tab-btn @(_activeTab == "fines" ? "active" : "")" @onclick="SelectFinesTab">
            My Fines
            @if (Fines.Any(f => !f.Paid))
            {
                <span class="badge ms-1" style="background:#c0392b; font-size:10px;">@Fines.Count(f => !f.Paid)</span>
            }
        </button>
    </li>
</ul>

@if (_activeTab == "loans")
{
    <MyLoansTable Items="Loans"
                FilterId="@FilterId"
                FilterIdChanged="@(v => FilterId = v)"
                FilterTitle="@FilterTitle"
                FilterTitleChanged="@(v => FilterTitle = v)"
                CurrentPage="@CurrentPage"
                CurrentPageChanged="@(v => CurrentPage = v)"
                PageSize="@PageSize"
                PageSizeChanged="@(v => PageSize = v)"
                OnExtendLoan="OpenExtendLoan"
                OnReturnBook="ReturnBookAsync" />
}
else
{
    <MyFinesTable Items="Fines"
                  FilterTitle="@FinesFilterTitle"
                  FilterTitleChanged="@(v => FinesFilterTitle = v)"
                  CurrentPage="@FinesCurrentPage"
                  CurrentPageChanged="@(v => FinesCurrentPage = v)"
                  PageSize="@FinesPageSize"
                  PageSizeChanged="@(v => FinesPageSize = v)"
                  OnPayFine="PayFineAsync" />
}

<DueDateModal IsOpen="@_showModal"
              IsOpenChanged="@(v => _showModal = v)"
              Saving="@_saving"
              Error="@_modalError"
              Title="Extend Loan"
              SubjectLabel="Book"
              SubjectValue="@_selectedLoan?.BookTitle"
              CurrentDueDate="@_selectedLoan?.DueDate"
              DueDateLabel="New Due Date"
              NewDueDate="@_newDueDate"
              NewDueDateChanged="@((DateOnly v) => _newDueDate = v)"
              OnCancel="CloseModal"
              OnConfirm="SaveAsync" />


