@page "/loans"
@using LibraryBlazor.Features.Loans.Models
@using LibraryBlazor.Features.Loans.Components
@using LibraryBlazor.Features.Books.Models
@using LibraryBlazor.Shared.Models
@using LibraryBlazor.Http
@using LibraryBlazor.Components
@implements IDisposable
@inject LibraryBlazor.Features.Loans.Services.LoanApi LoanApi

<PageTitle>Loans</PageTitle>

<LoansTable Items="Loans"
            FilterId="@FilterId"
            FilterIdChanged="@(v => FilterId = v)"
            FilterBookCopyId="@FilterBookCopyId"
            FilterBookCopyIdChanged="@(v => FilterBookCopyId = v)"
            FilterCopyCode="@FilterCopyCode"
            FilterCopyCodeChanged="@(v => FilterCopyCode = v)"
            FilterTitle="@FilterTitle"
            FilterTitleChanged="@(v => FilterTitle = v)"
            CurrentPage="@CurrentPage"
            CurrentPageChanged="@(v => CurrentPage = v)"
            PageSize="@PageSize"
            PageSizeChanged="@(v => PageSize = v)"
            OnExtendLoan="OpenExtendLoan"
            OnReturnBook="ReturnBookAsync"
            OnHistory="OpenHistoryAsync" />

<DueDateModal IsOpen="@_showModal"
                  IsOpenChanged="@(v => _showModal = v)"
                  Saving="@_saving"
                  Error="@_modalError"
                  Title="Extend Loan"
                  SubjectLabel="Book"
                  SubjectValue="@_selectedLoan?.BookTitle"
                  CurrentDueDate="@_selectedLoan?.DueDate"
                  DueDateLabel="New Due Date"
                  NewDueDate="@_newDueDate"
                  NewDueDateChanged="@((DateOnly v) => _newDueDate = v)"
                  OnCancel="CloseModal"
                  OnConfirm="SaveAsync" />

<HistoryModal IsOpen="@_showHistoryModal"
              IsOpenChanged="@(v => _showHistoryModal = v)"
              Loading="@_historyLoading"
              Error="@_historyError"
              Events="@_historyEvents"
              SingleCopyMode="true"
              CopyCode="@_historyCopyCode"
              BookTitle="@_historyBookTitle" />

@code {
    private readonly CancellationTokenSource _cts = new();

    private List<LoanRowVm> Loans = new();
    private bool _showModal;
    private bool _saving;
    private string FilterId = "";
    private string FilterBookCopyId = "";
    private string FilterCopyCode = "";
    private string FilterTitle = "";
    private int CurrentPage = 1;
    private int PageSize = 10;
    private LoanRowVm? _selectedLoan;
    private DateOnly _newDueDate;
    private string? _modalError;

    private bool _showHistoryModal;
    private bool _historyLoading;
    private string? _historyError;
    private Dictionary<Guid, List<LoanHistoryEventDto>>? _historyEvents;
    private string? _historyCopyCode;
    private string? _historyBookTitle;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    public void Dispose() => _cts.Cancel();

    private async Task ReloadAsync()
    {
        var result = await LoanApi.GetLoansAsync(_cts.Token);
        if (!result.Success)
        {
            Loans = new();
            _modalError = result.Message;
            return;
        }

        Loans = (result.Data ?? Array.Empty<LoanDto>())
            .Select(b => new LoanRowVm(b))
            .ToList();
    }

    private Task OpenExtendLoan(LoanRowVm loan)
    {
        _selectedLoan = loan;
        _newDueDate = loan.DueDate;
        _modalError = null;
        _showModal = true;
        return Task.CompletedTask;
    }

    private async Task ReturnBookAsync(LoanRowVm loan)
    {
        var result = await LoanApi.ReturnBookAsync(loan.UserId, loan.BookCopyId, _cts.Token);
        if (result.Success)
            await ReloadAsync();
    }

    private async Task OpenHistoryAsync(LoanRowVm loan)
    {
        _historyEvents = null;
        _historyError = null;
        _historyCopyCode = loan.CopyCode;
        _historyBookTitle = loan.BookTitle;
        _historyLoading = true;
        _showHistoryModal = true;

        var result = await LoanApi.GetBookCopyHistoryAsync(loan.BookCopyId, _cts.Token);

        _historyLoading = false;

        if (!result.Success || result.Data == null)
        {
            _historyError = result.Message ?? "Failed to load history.";
            return;
        }

        _historyEvents = new Dictionary<Guid, List<LoanHistoryEventDto>>
        {
            [loan.BookCopyId] = result.Data
        };
    }

    private void CloseModal()
    {
        if (_saving) return;
        _showModal = false;
        _modalError = null;
    }

    private async Task SaveAsync()
    {
        if (_selectedLoan is null) return;

        _saving = true;
        _modalError = null;

        try
        {
            var result = await LoanApi.ExtendLoanAsync(_selectedLoan.Id,
                new ExtendLoanRequestDto(_newDueDate), _cts.Token);

            if (!result.Success)
            {
                _modalError = result.Message ?? "Unknown error";
                return;
            }

            _showModal = false;
            await ReloadAsync();
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
