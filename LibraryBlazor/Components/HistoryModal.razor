@using LibraryBlazor.Features.Books.Models

@if (IsOpen)
{
    <div class="book-modal-overlay show" role="dialog" aria-modal="true" @onclick="Close">
        <div class="book-modal history-modal" @onclick:stopPropagation>
            <div class="book-modal-header">
                <h3 class="book-modal-title">
                    @if (_selectedCopyId.HasValue && !SingleCopyMode)
                    {
                        <button type="button" class="book-modal-close me-2" @onclick="BackToCopyList" aria-label="Back">
                            <i class="bi bi-arrow-left"></i>
                        </button>
                    }
                    <i class="bi bi-clock-history me-2"></i>Loan History
                </h3>
                <button type="button" class="book-modal-close" @onclick="Close" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="book-modal-body history-modal-body">
                @if (Loading)
                {
                    <div class="history-loading">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                        <span>Loading history…</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger">@Error</div>
                }
                else if (Events == null || !Events.Any())
                {
                    <div class="history-empty">
                        @if (!string.IsNullOrEmpty(CopyCode) && !string.IsNullOrEmpty(BookTitle))
                        {
                            <span>Copy <strong>@CopyCode</strong> of book <strong>@BookTitle</strong> has no loan history.</span>
                        }
                        else
                        {
                            <span>No loan history found for this book.</span>
                        }
                    </div>
                }
                else if (_selectedCopyId.HasValue && Events.TryGetValue(_selectedCopyId.Value, out var selectedEvents))
                {
                    @* ── Timeline view for a single copy ── *@
                    <div class="history-copy-section">
                        <div class="history-copy-header">
                            <i class="bi bi-upc-scan me-2"></i>Copy: @(selectedEvents.FirstOrDefault()?.CopyCode ?? CopyCode ?? _selectedCopyId.Value.ToString())
                        </div>
                        @if (!selectedEvents.Any())
                        {
                            <div class="history-empty">
                                @if (!string.IsNullOrEmpty(CopyCode) && !string.IsNullOrEmpty(BookTitle))
                                {
                                    <span>Copy <strong>@CopyCode</strong> of book <strong>@BookTitle</strong> has no loan history.</span>
                                }
                                else
                                {
                                    <span>No loan history found for this copy.</span>
                                }
                            </div>
                        }
                        else
                        {
                        <div class="history-timeline">
                            @for (int i = 0; i < selectedEvents.Count; i++)
                            {
                                var ev = selectedEvents[i];
                                bool isLast = i == selectedEvents.Count - 1;
                                bool isLoaned = ev.EventType == "Loaned";
                                <div class="timeline-item @(isLast ? "timeline-item-last" : "")">
                                    <div class="timeline-connector-wrap">
                                        <div class="timeline-dot @(isLoaned ? "dot-loaned" : "dot-returned")"></div>
                                        @if (!isLast)
                                        {
                                            <div class="timeline-line"></div>
                                        }
                                    </div>
                                    <div class="timeline-content">
                                        <div class="timeline-event-type @(isLoaned ? "event-loaned" : "event-returned")">
                                            @(isLoaned ? "Loaned" : "Returned")
                                        </div>
                                        <div class="timeline-date">@ev.Date.ToString("MMM d, yyyy")</div>
                                    </div>
                                </div>
                            }
                        </div>
                        } @* end else (has events) *@
                    </div>
                }
                else if (!SingleCopyMode)
                {
                    @* ── Copy list view ── *@
                    @foreach (var copy in Events)
                    {
                        var copyCode = copy.Value.FirstOrDefault()?.CopyCode ?? copy.Key.ToString();
                        <div class="history-copy-section">
                            <div class="history-copy-header d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-upc-scan me-2"></i>Copy: @copyCode</span>
                                <button type="button" class="bm-btn bm-btn-secondary" @onclick="() => ShowCopyHistory(copy.Key)">
                                    Show History
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="book-modal-footer">
                <button type="button" class="bm-btn bm-btn-secondary" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}
